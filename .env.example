# Скопируй в .env и заполни. Файл .env в .gitignore — секреты в репозиторий не попадут.

# --- hh.ru -----------------------------------------------------------------
# Приложение регистрируется на https://dev.hh.ru/admin
# Redirect URI в настройках приложения должен совпадать с HH_REDIRECT_URI ниже.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8765/callback

# hh.ru просит указывать в User-Agent название приложения и контакт.
HH_USER_AGENT=autoapply/1.0 (zibaevlexa@gmail.com)

# --- Habr Career (нужно только для автоотклика) -----------------------------
# У Habr Career нет API отклика для соискателя, поэтому единственный путь —
# cookie из твоего браузера. Нужно только если в config.yaml включено
# habr.apply_enabled: true. Как достать cookie — см. README.
HABR_REMEMBER_TOKEN=
HABR_SESSION=

# --- getmatch (нужно только для автоотклика) --------------------------------
# Вход на getmatch только по одноразовому коду, API-ключей нет.
# Нужно только если в config.yaml включено getmatch.apply_enabled: true.
GETMATCH_SESSION=

# --- LLM для сопроводительных писем ----------------------------------------
# Нужен только тот ключ, который соответствует letters.llm_provider в config.yaml.
OPENAI_API_KEY=
# Для OpenAI-совместимого прокси поменяй базовый URL:
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
